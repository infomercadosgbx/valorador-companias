   {
    "concepto": "beneficio_operativo",
    "min": 28500000000.0,
    "max": 33500000000.0,
    "medio": 31000000000.0,
    "texto": "Operating income is expected to be between $28.5 billion and $33.5 billion, compared with $25.0 billion in fourth quarter 2025.",
    "estimado": {
     "valor": 33100000000.0,
     "fuente": "manual · Infografía Invertir Desde Cero (resultados 3T26)",
